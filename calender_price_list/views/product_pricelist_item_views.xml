<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="product_pricelist_item_view_form" model="ir.ui.view">
        <field name="name">product.pricelist.item.calender.price.form</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_rule_method']/field[1]" position="before">
                <field name="pricelist_id" required="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_view_calendar" model="ir.ui.view">
        <field name="name">product.pricelist.item.calender.price.calendar</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <calendar string="Pricelist Rules"
                      date_start="date_start"
                      date_stop="date_end"
                      color="pricelist_id"
                      mode="month"
                      quick_create="false"
                      event_open_popup="true"
                      form_view_id="%(product_pricelist_item_view_form)d">
                <field name="name"/>
                <field name="pricelist_id"/>
                <field name="price"/>
                <field name="min_quantity"/>
            </calendar>
        </field>
    </record>

    <record id="action_calender_price" model="ir.actions.act_window">
        <field name="name">Pricelist Rules</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">calendar,form</field>
        <field name="search_view_id" ref="product.product_pricelist_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a pricelist rule</p>
            <p>Set a validity period to display the rule in the calendar.</p>
        </field>
    </record>



    <record id="action_calender_price_calendar" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="product_pricelist_item_view_calendar"/>
        <field name="act_window_id" ref="action_calender_price"/>
    </record>

    <record id="action_calender_price_form" model="ir.actions.act_window.view">
        <field name="sequence">30</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_pricelist_item_view_form"/>
        <field name="act_window_id" ref="action_calender_price"/>
    </record>

    <menuitem id="menu_calender_price"
              name="Calender Price"
              parent="sale.product_menu_catalog"
              action="action_calender_price"
              groups="product.group_product_pricelist"
              sequence="31"/>
    <menuitem id="menu_pos_calender_price"
              name="Calender Price"
              parent="point_of_sale.pos_config_menu_catalog"
              action="action_calender_price"
              groups="product.group_product_pricelist"
              sequence="21"/>
</odoo>
